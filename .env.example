GOOGLE_API_KEY=your-google-api-key-here
ADMIN_TOKEN=generate-a-long-random-admin-token
ANALYSIS_REPEAT_HMAC_KEY=generate-a-separate-long-random-cache-key
# On Render, mount the persistent disk at /var/data and set this value to
# /var/data/private-analysis-cache/analysis-repeat-cache.sqlite3.
ANALYSIS_REPEAT_CACHE_PATH=work/private-analysis-cache/analysis-repeat-cache.sqlite3
PORT=5002
DEMO_MODE=false
DEBUG=false
